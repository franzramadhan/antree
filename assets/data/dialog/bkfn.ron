// The national photocopy agency is a stall across the road with one copier.
{
    "greet": ["\"Copies? Photos? Folders? Duty stamps? We have all of it. The copier is warming up since 2009.\""],
    "missing": ["\"I copy what you bring. Bring the {doc}.\""],
    "issued": ["\"Done. Still warm. Next!\"", "\"Here. The colour is close enough. Probably.\""],
