// Lines every office uses unless dialog/<office>.ron overrides the key.
// Each key holds variants; one is picked per moment. {placeholders} are filled by the game.
{
    "greet": ["Yes, what is it?", "Number? You need a number. The machine is broken, so remember one."],
    "missing": [
        "You are missing the {doc}, sir. Did you photocopy it?",
        "Without the {doc} I cannot process this. I did not make the rules. I only enforce them, with enthusiasm.",
    ],
    "issued": ["Done. Do not lose it. We do not keep a copy.", "Stamped. Next!"],
    "nothing": ["There is nothing here for you, sir. Next.", "Wrong counter. Wrong building, actually."],
    "cannot_pay": ["\"That is Kv {fee}, sir.\" You count your money twice. It does not get bigger."],
    "numbers_closed": ["\"Numbers closed at eleven thirty.\" It is eleven thirty-two. Come back tomorrow."],
    "closed_now": ["The shutter comes down mid-sentence. 15:00 means 15:00. Come back tomorrow."],
    "locked": ["The front door is locked. A sign says USE THE OTHER DOOR. There is no other door. Come back in a few days."],
    "under_review": ["\"Your file is under review, sir.\" Reviews take time. Come back in a couple of days."],
    "leave_closed": ["A paper on the door: COLLECTIVE LEAVE. No dates. The whole day is gone."],
    "inside_man": ["You make one call. The clerk's phone rings. He listens, nods, and stamps your paper without reading it."],
    "clerk_note": [
        "Clerk's note: applicant was patient. Noted.",
        "Clerk's note: please bring a photocopy of this ending.",
        "Clerk's note: file closed. Another file opened. It is yours.",
        "Clerk's note: the system was down during your evaluation. Your grade is an estimate.",
    ],

    "ob_break": ["\"The clerk is on break.\" You wait {min} minutes. The break was longer than the work."],
    "ob_moved": ["\"This counter moved to the other building last month.\" You walk over. 20 minutes. The other building sends you back."],
    "ob_system": ["\"Sir, the system is down. Head office.\""],
    "ob_paperwork": ["\"Where is the photocopy? You need the photocopy. The stall is across the road.\""],
    "ob_form": ["\"That is the old form. New format since this morning.\""],
    "ob_fixer": ["A man in a vest falls into step beside you. \"Busy today, sir. I can walk your file in. For a small consideration.\""],
    "ob_nego": ["The clerk leans back. \"If you want it fast, there is... an administrative fee. Unofficial, of course.\""],

    "q_wait": ["You wait.", "You wait. A ceiling fan turns slowly. It does not help.", "You wait. Somebody's phone plays a ringtone for a full minute."],
    "q_nothing": ["Nothing to do about that right now."],
    "q_auntie_wait": ["She just had a quick question. It took a while."],
    "q_inside_wait": ["He walked straight in. Nobody said anything. Neither did you."],
    "q_fixer_ignored": ["You looked at your shoes. The fixer moved on."],
    "q_confront_ok": ["\"Oh, sorry sir, did not see you.\" The line is restored."],
    "q_confront_fight": ["Voices rise. The guard picks you. Come back tomorrow."],
    "q_confront_fail": ["\"I am only asking!\" She stays. So does everyone behind you."],
    "q_cut_caught": ["\"Sir. Sir! Back of the line.\" Everyone watched."],
    "q_cut_ok": ["You slid forward. Nobody said anything. You feel it anyway."],
    "q_fixer_paid": ["A folded note, a nod, and your name is suddenly next."],
    "q_event_auntie": ["An auntie slides in front of you. \"Just a quick question.\""],
    "q_event_inside": ["A man in a batik shirt walks past the whole line toward the counter."],
    "q_event_fixer": ["A fixer leans in. \"Front of the line, Kv {price}. Today only.\""],
    "q_closed": ["The counter closes in front of you. The clerk does not look up."],

    "f_intro": ["\"Fill this in. Follow the format at the top. The format is important.\""],
    "f_rejected": ["\"Rejected. {n} wrong. Fill it in again, sir.\" Which ones? The clerk does not say."],
    "f_timeout": ["\"Time is up, sir. Others are waiting.\" Rejected."],
    "f_tomorrow": ["\"Three times wrong. Come back tomorrow, sir. Bring a pen that works.\""],
    "f_nonsense": ["You write whatever. The clerk stamps it without reading. Nobody reads these. Probably."],

    "s_intro": ["\"The stamp? The stamp is with... someone. Ask around.\""],
    "s_clue": ["\"The stamp? Try desk {desk}.\"", "\"Desk {desk}, I think. Maybe.\"", "\"Not me. Desk {desk}.\""],
    "s_break": ["The stamp holder is on break. \"Back in {min} minutes.\""],
    "s_meeting": ["The stamp holder is in a meeting. \"Back in {min} minutes, maybe.\""],
    "s_waited": ["They come back. They stamp it. They do not apologize."],
    "s_field": ["\"Oh, the stamp went out on field duty. With him. Come back another day.\""],
    "s_late": ["\"It is almost three, sir. The stamp is resting.\""],

    "p_brief": ["\"{order}\" The clerk says it once and looks away."],
    "p_wrong": ["\"Wrong {item}. Again.\" The clerk repeats the order, faster."],
    "p_closed": ["You run back. The window says CLOSED FOR NEW FILES. It is 11:31."],

    "o_wait": ["You wait. The bar does not move.", "You wait. Someone says it is the cable. Someone else says it is the rain."],
    "o_refresh": ["\"Has it come back?\" \"No.\""],
    "o_annoyed": ["\"Sir. If you ask again it will take longer.\" It takes longer."],
    "o_honorer": ["Mas Honorer sips your coffee. \"{min} more minutes. Trust me.\""],
    "o_back": ["The system is back. Everyone pretends it never left."],
    "o_home": ["You give up your number and go home. Tomorrow the system will be up. Probably."],

    "n_paid": ["A folded note. A nod. Your file moves to the top of a pile you cannot see."],
    "n_declined": ["\"As you wish, sir.\" The clerk smiles. You will remember that smile."],
    "n_fixer_declined": ["The fixer shrugs and finds someone else. Someone always says yes."],
    "n_replaced": ["A supervisor appears, apologizes, replaces the clerk, and processes your file himself. Rare."],
    "n_review": ["\"A report? Then your file must be reviewed first.\" It will be reviewed for two days."],

    "t_intro": ["\"Your old SIM expired yesterday, so: theory test. Kv 25. Begin.\""],
    "t_pass": ["\"Passed. Congratulations, you understand queues.\""],
    "t_fail": ["\"{score} out of 10. Retake tomorrow. Kv 25 again.\""],
}
