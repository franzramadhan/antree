// Lines every office uses unless dialog/<office>.ron overrides the key.
// Each key holds variants; one is picked per moment. {placeholders} are filled by the game.
{
    "greet": ["Ya, ada apa?", "Nomor? Harus ambil nomor. Mesinnya rusak, jadi hafalkan saja satu."],
    "missing": [
        "Anda belum bawa {doc}, Pak. Sudah difotokopi?",
        "Tanpa {doc} saya tidak bisa proses. Bukan saya yang buat aturan. Saya cuma menegakkannya, dengan semangat.",
    ],
    "issued": ["Selesai. Jangan hilang. Kami tak simpan salinan.", "Distempel. Berikutnya!"],
    "nothing": ["Tak ada urusan Anda di sini, Pak. Berikutnya.", "Salah konter. Salah gedung, malah."],
    "cannot_pay": ["\"Kv {fee}, Pak.\" Anda hitung uang Anda dua kali. Tidak bertambah juga."],
    "numbers_closed": ["\"Nomor tutup jam 11:30.\" Sekarang 11:32. Datang lagi besok."],
    "closed_now": ["Rolling door turun di tengah kalimat. 15:00 artinya 15:00. Datang lagi besok."],
    "locked": ["Pintu depan dikunci. Ada tulisan PAKAI PINTU LAIN. Tidak ada pintu lain. Kembali beberapa hari lagi."],
    "door_sandals": ["Penjaga menghadang di pintu. \"Sandal? Ini kantor pemerintah, Pak.\" Sepatu di kios luar Kv {kv}. Anda tidak punya Kv {kv}."],
    "door_shoes": ["Penjaga menunjuk kaki Anda. \"Tidak boleh sandal.\" Kios di luar jual sepatu, satu ukuran, Kv {kv}. Sempit. Anda masuk.", "\"Aturan pakaian, Pak.\" Kv {kv} dan dua puluh menit kemudian sepatu Anda mencicit di lantai."],
    "door_parking": ["Penjaga menyodorkan karcis. \"Parkir, Kv {kv}.\" Anda jalan kaki ke sini. \"Parkir, Kv {kv}.\"", "\"Uang parkir.\" Anda bilang tidak bawa kendaraan. \"Kalau begitu murah, Kv {kv}.\""],
    "under_review": ["\"Berkas Anda sedang ditinjau, Pak.\" Peninjauan butuh waktu. Kembali dua hari lagi."],
    "leave_closed": ["Kertas di pintu: CUTI BERSAMA. Tanpa tanggal. Seharian hangus."],
    "inside_man": ["Anda menelepon sekali. Telepon petugas berdering. Dia dengar, mengangguk, lalu stempel kertas Anda tanpa baca."],
    "clerk_note": [
        "Catatan petugas: pemohon sabar. Dicatat.",
        "Catatan petugas: harap bawa fotokopi ending ini.",
        "Catatan petugas: berkas ditutup. Berkas lain dibuka. Punya Anda.",
        "Catatan petugas: sistem down saat penilaian Anda. Nilai Anda hanya perkiraan.",
    ],

    "ob_break": ["\"Petugasnya istirahat.\" Anda tunggu {min} menit. Istirahatnya lebih lama dari kerjanya."],
    "ob_moved": ["\"Konter ini pindah ke gedung sebelah bulan lalu.\" Anda jalan ke sana. 20 menit. Gedung sebelah menyuruh Anda balik."],
    "ob_system": ["\"Pak, sistemnya down. Dari pusat.\""],
    "ob_paperwork": ["\"Fotokopinya mana? Harus ada fotokopi. Kiosnya di seberang jalan.\""],
    "ob_form": ["\"Itu formulir lama. Format baru sejak tadi pagi.\""],
    "ob_fixer": ["Pria berompi berjalan di samping Anda. \"Ramai hari ini, Pak. Berkasnya bisa saya bawa masuk. Seikhlasnya saja.\""],
    "ob_nego": ["Petugas bersandar. \"Kalau mau cepat, ada... biaya administrasi. Tidak resmi, tentu saja.\""],

    "q_wait": ["Anda menunggu.", "Anda menunggu. Kipas angin berputar pelan. Tidak membantu.", "Anda menunggu. Ringtone HP seseorang bunyi satu menit penuh."],
    "q_nothing": ["Belum ada yang bisa dilakukan."],
    "q_auntie_wait": ["Katanya cuma mau tanya sebentar. Ternyata lama."],
    "q_inside_wait": ["Dia langsung masuk. Tidak ada yang bilang apa-apa. Anda juga tidak."],
    "q_fixer_ignored": ["Anda menatap sepatu sendiri. Calonya pergi."],
    "q_confront_ok": ["\"Eh, maaf Pak, tidak lihat.\" Antrean kembali normal."],
    "q_confront_fight": ["Ribut. Penjaga memilih Anda. Datang lagi besok."],
    "q_confront_fail": ["\"Saya cuma tanya!\" Dia tetap. Semua di belakang Anda juga."],
    "q_cut_caught": ["Penjaga mengetuk kepala Anda pakai pentungan. Tok. \"Keluar. Besok datang lagi, antre seperti warga.\" Semua melihat.", "Peluit. Penjaga menyeret kerah Anda keluar sementara seluruh antrean bertepuk tangan. Datang lagi besok."],
    "q_cut_ok": ["Anda maju diam-diam. Tak ada yang protes. Tetap saja terasa."],
    "q_fixer_paid": ["Uang terlipat, anggukan, tiba-tiba Anda berikutnya."],
    "q_event_auntie": ["Seorang ibu menyelip di depan Anda. \"Cuma mau tanya sebentar.\""],
    "q_event_inside": ["Pria berbaju batik berjalan melewati seluruh antrean menuju konter."],
    "q_event_double": ["Pria bersafari memegang nomor yang sama. Nodanya juga sama."],
    "q_double_wait": ["Anda biarkan dia duluan. Rasanya seperti duplikat."],
    "q_double_won": ["\"Lihat jam di stempelnya, Pak.\" Dia duduk. Nomor itu milik Anda."],
    "q_double_lost": ["\"Saya datang jam enam!\" Petugas memihak dia. Mundur dua tempat karena ribut."],
    "q_event_fixer": ["Calo mendekat. \"Paling depan, Kv {price}. Hari ini saja.\""],
    "q_closed": ["Konter tutup tepat di depan Anda. Petugas tidak menoleh."],

    "f_intro": ["\"Isi ini. Ikuti format di atas. Formatnya penting.\""],
    "f_rejected": ["\"Ditolak. {n} salah. Isi ulang, Pak.\" Yang mana? Petugas tidak bilang."],
    "f_timeout": ["\"Waktu habis, Pak. Yang lain menunggu.\" Ditolak."],
    "f_tomorrow": ["\"Tiga kali salah. Datang lagi besok, Pak. Bawa pulpen yang jalan.\""],
    "f_nonsense": ["Anda tulis asal-asalan. Petugas menstempel tanpa membaca. Tidak ada yang membaca ini. Mungkin."],

    "s_intro": ["\"Stempel? Stempelnya ada di... seseorang. Tanya saja.\""],
    "s_clue": ["\"Stempel? Coba meja {desk}.\"", "\"Meja {desk}, kayaknya. Mungkin.\"", "\"Bukan saya. Meja {desk}.\""],
    "s_break": ["Pemegang stempel istirahat. \"Kembali {min} menit lagi.\""],
    "s_meeting": ["Pemegang stempel sedang rapat. \"Kembali {min} menit lagi, mungkin.\""],
    "s_waited": ["Dia kembali. Dia menstempel. Dia tidak minta maaf."],
    "s_field": ["\"Oh, stempelnya sedang dinas luar. Ikut beliau. Datang lagi lain hari.\""],
    "s_late": ["\"Hampir jam tiga, Pak. Stempelnya istirahat.\""],

    "p_brief": ["\"{order}\" Petugas bilang sekali lalu buang muka."],
    "p_wrong": ["\"Salah {item}. Ulang.\" Petugas mengulang pesanan, lebih cepat."],
    "p_closed": ["Anda lari balik. Jendela bertulisan TUTUP UNTUK BERKAS BARU. Jam 11:31."],

    "o_wait": ["Anda menunggu. Bar tidak bergerak.", "Anda menunggu. Ada yang bilang kabelnya. Ada yang bilang hujan."],
    "o_refresh": ["\"Sudah nyala?\" \"Belum.\""],
    "o_annoyed": ["\"Pak. Kalau tanya lagi, nanti makin lama.\" Makin lama."],
    "o_reronoh": ["Mas Reronoh menyeruput kopi Anda. \"{min} menit lagi. Percaya saya.\""],
    "o_back": ["Sistem kembali. Semua pura-pura tidak pernah mati."],
    "o_home": ["Anda lepas nomor antrean dan pulang. Besok sistemnya nyala. Mungkin."],

    "n_paid": ["Uang terlipat. Anggukan. Berkas Anda naik ke atas tumpukan yang tak kelihatan."],
    "n_declined": ["\"Terserah Bapak.\" Petugas tersenyum. Anda akan ingat senyum itu."],
    "n_fixer_declined": ["Calo mengangkat bahu dan cari orang lain. Selalu ada yang mau."],
    "n_replaced": ["Seorang atasan datang, minta maaf, mengganti petugas, dan memproses berkas Anda sendiri. Langka."],
    "n_review": ["\"Laporan? Kalau begitu berkas Anda harus ditinjau dulu.\" Ditinjau selama dua hari."],

    "t_intro": ["\"SIM lama Anda habis kemarin, jadi: ujian teori. Kv 25. Mulai.\""],
    "t_pass": ["\"Lulus. Selamat, Anda paham antre.\""],
    "t_fail": ["\"{score} dari 10. Ulang besok. Kv 25 lagi.\""],
}
