{
    "greet": ["\"Small District Sabar Menanti, Kuvukiland. Silakan duduk. Kursi mana saja. Rusaknya sama semua.\""],
    "missing": ["\"Tanpa {doc}, tidak ada surat. Pak Gnilak dulu. Selalu Pak Gnilak.\""],
    "issued": ["\"Surat pengantar. Ditandatangani Pah Harul, yang tidak ada, jadi a.n. Pah Harul.\""],
    "nothing": ["\"Surat kami sudah Bapak pegang. Mau apa lagi, mebel kami?\""],
}
