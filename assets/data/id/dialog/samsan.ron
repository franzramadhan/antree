    "issued.stnkk": ["\"STNKK Bapak. Motornya resmi milik Bapak. Begitu juga tilang parkir lamanya.\""],
    "issued": ["\"Dicap. Motor berikutnya.\""],
    "nothing": ["\"Surat Bapak sudah beres. Motornya belum. Itu urusan bengkel.\""],
